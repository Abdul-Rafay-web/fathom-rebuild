# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Deepgram: speech-to-text with speaker labels (and multi-voice TTS for seed audio)
DEEPGRAM_API_KEY=

# Google Gemini: summaries, action items, Ask, embeddings
GEMINI_API_KEY=

# Supabase: Postgres + pgvector + file storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase > Connect > "Transaction pooler", port 6543)
DATABASE_URL=
